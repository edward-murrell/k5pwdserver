[Unit]
Description=Kerberos password change web service
Documentation=https://github.com/edward-murrell/k5pwdserver
After=network-online.target
Wants=network-online.target

[Service]
# Defaults. /etc/default/k5pwdserver overrides them.
Environment=LISTEN=127.0.0.1:8080
Environment=USER_FAILURES=5
Environment=IP_FAILURES=20
Environment=FAILURE_WINDOW=15m
Environment=GIN_MODE=release
EnvironmentFile=-/etc/default/k5pwdserver
# ${VAR} passes each value as one argument, so titles can contain spaces.
# Empty string values fall back to the built-in defaults. The numeric options
# can't be empty, so their defaults are set above.
ExecStart=/usr/sbin/k5pwdserver -listen ${LISTEN} -tls-cert ${TLS_CERT} -tls-key ${TLS_KEY} \
    -realms ${REALMS} -title ${TITLE} \
    -user-failures ${USER_FAILURES} -ip-failures ${IP_FAILURES} \
    -failure-window ${FAILURE_WINDOW} -trusted-proxies ${TRUSTED_PROXIES}
Restart=on-failure

DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
